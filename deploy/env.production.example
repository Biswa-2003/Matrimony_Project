# Copy to /var/www/matrimoney/.env.production on the server and fill in every value.
# Never commit the real file (.env* is already in .gitignore).
# Create each secret on the server with:   openssl rand -hex 32

NODE_ENV=production

# printed at the end of setup-server.sh
DATABASE_URL=postgresql://matrimoney:CHANGE_ME@localhost:5432/matrimoney

# your site's address, with https and no slash at the end (used in emails, links, SEO)
NEXT_PUBLIC_BASE_URL=https://YOUR_DOMAIN

# NEW long random values - do not reuse the ones from your laptop
JWT_SECRET=CHANGE_ME
CRON_SECRET=CHANGE_ME

# Gmail address + 16-character app password (Google account > Security > App passwords)
EMAIL_USER=CHANGE_ME@gmail.com
EMAIL_PASS=CHANGE_ME
SUPPORT_EMAIL=CHANGE_ME@gmail.com

# hide the demo login buttons on the live site
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false

# AI assistant (copy from your .env.local if you use it)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Razorpay keys (plans can't be bought until these are set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# KEEP false on the live site: true lets anyone activate a paid plan without paying
PAYMENTS_TEST_MODE=false

# always ask for the email code at sign-up (admins can hand one out from Admin > Sign-up OTP Help)
REQUIRE_EMAIL_OTP=true

# Optional: Vercel Blob for images (otherwise they are stored in the database)
BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private

# daily database backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/matrimoney
BACKUP_KEEP=14
